#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/rgbled_widget.dtsi>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        scroll_left_right: behavior_sensor_rotate_mouse_wheel_left_right {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;

            tap-ms = <20>;
        };  
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W           &kp E     &kp R      &kp T                                        &kp Y     &kp U    &kp I           &kp O    &kp P
&kp A      &kp S           &kp D     &kp F      &kp G                                        &kp H     &kp J    &kp K           &kp L    &kp MINUS
&kp Z      &kp X           &kp C     &kp V      &kp B                                        &kp N     &kp M    &kp COMMA       &kp DOT  &kp SLASH
&kp LCTRL  &mt PSCRN LWIN  &kp LALT  &kp LSHFT  &lt 1 LA(GRAVE)  &lt 2 SPACE    &lt 3 ENTER  &kp BSPC  &kp DEL  &mt PSCRN CAPS  &kp TAB  &lt 4 ESC
            >;

            sensor-bindings = <&scroll_up_down>, <&scroll_left_right>;
        };

        layer_1 {
            bindings = <
&kp LC(Y)  &kp LC(Z)  &kp LC(V)  &kp LC(C)  &kp LC(LS(C))                    &trans  &trans  &trans  &trans  &trans
&trans     &trans     &kp UP     &trans     &kp LC(S)                        &trans  &trans  &trans  &trans  &trans
&trans     &kp LEFT   &kp DOWN   &kp RIGHT  &trans                           &trans  &trans  &trans  &trans  &trans
&trans     &trans     &trans     &trans     &trans         &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&scroll_up_down>, <&scroll_left_right>;
        };

        layer_2 {
            bindings = <
&kp MINUS  &kp N7  &kp N8  &kp N9  &kp PLUS                     &kp LPAR  &kp RPAR  &kp EXCL  &kp AT     &kp HASH
&kp SLASH  &kp N4  &kp N5  &kp N6  &kp ASTRK                    &kp LBKT  &kp RBKT  &kp DLLR  &kp PRCNT  &kp CARET          
&kp N0     &kp N1  &kp N2  &kp N3  &kp EQUAL                    &kp LT    &kp GT    &kp AMPS  &kp SEMI   &kp SQT
&kp CARET  &trans  &trans  &trans  &trans     &trans    &trans  &trans    &trans    &trans    &trans     &trans                  
            >;

            sensor-bindings = <&scroll_up_down>, <&scroll_left_right>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &kp F1   &kp F2   &kp F3  &kp F4  &kp F5
&trans  &trans  &trans  &trans  &trans                    &kp F6   &kp F7   &kp F8  &kp F9  &kp F10
&trans  &trans  &trans  &trans  &trans                    &kp F11  &kp F12  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans   &trans   &trans  &trans  &trans 
            >;

            sensor-bindings = <&scroll_up_down>, <&scroll_left_right>;
        };

        layer_4 {
            bindings = <
&bt BT_SEL 4    &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0                         &studio_unlock  &trans  &trans  &trans  &trans 
&bt BT_CLR_ALL  &trans        &trans        &trans        &ind_bat                             &trans  &trans  &trans  &trans  &trans
&bt BT_CLR      &trans        &trans        &trans        &trans                               &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &bootloader    &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&scroll_up_down>, <&scroll_left_right>;
        };

        // ZMK Studio から追加できる予備レイヤー (通常ビルドでは無視されます)
        layer_5 { status = "reserved"; };
        layer_6 { status = "reserved"; };
        layer_7 { status = "reserved"; };
    };
};
