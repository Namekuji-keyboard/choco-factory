diff -ru choco-key/original/build.yaml choco-key/studio/build.yaml
--- choco-key/original/build.yaml	2026-11-20 21:44:26.748943500 +0900
+++ choco-key/studio/build.yaml	2026-11-20 21:44:41.012598400 +0900
@@ -1,7 +1,12 @@
 ---
+# ZMK Studio 対応版:
+#   セントラルである右手 (Choco-Key_R) のみに studio-rpc-usb-uart スニペットと CONFIG_ZMK_STUDIO を追加。
+#   左手 (ペリフェラル) と settings_reset は変更なし。
 include:
   - board: seeeduino_xiao_ble
     shield: Choco-Key_R rgbled_adapter
+    snippet: studio-rpc-usb-uart
+    cmake-args: -DCONFIG_ZMK_STUDIO=y
   - board: seeeduino_xiao_ble
     shield: Choco-Key_L rgbled_adapter
   - board: seeeduino_xiao_ble
diff -ru choco-key/original/config/Choco-Key.keymap choco-key/studio/config/Choco-Key.keymap
--- choco-key/original/config/Choco-Key.keymap	2026-11-20 21:44:26.389645300 +0900
+++ choco-key/studio/config/Choco-Key.keymap	2026-11-20 21:44:56.339595500 +0900
@@ -99,7 +99,7 @@
 
         layer_4 {
             bindings = <
-&bt BT_SEL 4    &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0                         &trans  &trans  &trans  &trans  &trans 
+&bt BT_SEL 4    &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0                         &studio_unlock  &trans  &trans  &trans  &trans 
 &bt BT_CLR_ALL  &trans        &trans        &trans        &ind_bat                             &trans  &trans  &trans  &trans  &trans
 &bt BT_CLR      &trans        &trans        &trans        &trans                               &trans  &trans  &trans  &trans  &trans
 &trans          &trans        &trans        &trans        &trans        &bootloader    &trans  &trans  &trans  &trans  &trans  &trans
@@ -107,5 +107,10 @@
 
             sensor-bindings = <&scroll_up_down>, <&scroll_left_right>;
         };
+
+        // ZMK Studio から追加できる予備レイヤー (通常ビルドでは無視されます)
+        layer_5 { status = "reserved"; };
+        layer_6 { status = "reserved"; };
+        layer_7 { status = "reserved"; };
     };
 };
