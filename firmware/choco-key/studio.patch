diff -ruN choco-key/original/CMakeLists.txt choco-key/studio/CMakeLists.txt
--- choco-key/original/CMakeLists.txt	1970-01-01 09:00:00.000000000 +0900
+++ choco-key/studio/CMakeLists.txt	2026-11-22 22:42:12.463499429 +0900
@@ -0,0 +1,3 @@
+# Choco Factory: ZMK Studio からエンコーダー・マクロ・コンボを即時変更するためのビヘイビア
+target_sources_ifdef(CONFIG_CHOCO_BEHAVIOR_VKEY app PRIVATE src/behavior_vkey.c)
+target_sources_ifdef(CONFIG_CHOCO_RUNTIME_COMBO app PRIVATE src/runtime_combo.c)
diff -ruN choco-key/original/Kconfig choco-key/studio/Kconfig
--- choco-key/original/Kconfig	1970-01-01 09:00:00.000000000 +0900
+++ choco-key/studio/Kconfig	2026-11-22 22:42:12.467517094 +0900
@@ -0,0 +1,22 @@
+# Choco Factory runtime configuration (ZMK v0.2.1)
+
+DT_COMPAT_CHOCO_BEHAVIOR_VKEY := zmk,behavior-choco-vkey
+DT_COMPAT_CHOCO_RUNTIME_COMBO := zmk,behavior-choco-runtime-combos
+
+config CHOCO_BEHAVIOR_VKEY
+    bool "Virtual key behavior (press the binding at a virtual key position)"
+    default $(dt_compat_enabled,$(DT_COMPAT_CHOCO_BEHAVIOR_VKEY))
+
+config CHOCO_RUNTIME_COMBO
+    bool "Combos configured from keymap bindings (editable with ZMK Studio)"
+    default $(dt_compat_enabled,$(DT_COMPAT_CHOCO_RUNTIME_COMBO))
+
+config CHOCO_RUNTIME_COMBO_MAX_PENDING
+    int "Max keys captured while a combo is being detected"
+    default 4
+    depends on CHOCO_RUNTIME_COMBO
+
+config CHOCO_RUNTIME_COMBO_MAX_ACTIVE
+    int "Max combos held at the same time"
+    default 4
+    depends on CHOCO_RUNTIME_COMBO
diff -ruN choco-key/original/build.yaml choco-key/studio/build.yaml
--- choco-key/original/build.yaml	2026-11-22 22:42:12.230368977 +0900
+++ choco-key/studio/build.yaml	2026-11-22 22:42:12.397315272 +0900
